+bool
+ProcessorBox::handle_hover_delete (Gtk::Window* window, GdkEventKey* ev)
+{
+	// Window accelerators run before widget key handlers. Handle hover Delete
+	// here so it also works when no processor has been clicked/selected.
+	if (!_current_processor_box || _current_processor_box->get_toplevel() != window) return false;
+	return _current_processor_box->processor_key_press(ev);
