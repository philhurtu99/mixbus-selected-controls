+
+bool
+ProcessorBox::processor_key_press (GdkEventKey* ev)
+{
+#ifdef MIXBUS
+	if ((ev->keyval == GDK_Delete || ev->keyval == GDK_BackSpace)
+	    && !(ev->state & (GDK_CONTROL_MASK | GDK_MOD1_MASK | GDK_META_MASK | GDK_SUPER_MASK))) {
+		int x, y;
+		processor_display.get_pointer (x, y);
+		if (x < 0 || y < 0 || x >= processor_display.get_allocation().get_width()
+		    || y >= processor_display.get_allocation().get_height()) return false;
+		auto child = processor_display.get_child_at_position(y).first;
+		if (!child) return true;
+		auto insert = std::dynamic_pointer_cast<PluginInsert> (child->processor());
+		// Hover deletion never removes built-in strip processors, faders or sends.
+		if (insert && !insert->is_channelstrip()) delete_processors (ProcSelection {insert});
+		return true;
+	}
+#endif
+	return false;
+}
