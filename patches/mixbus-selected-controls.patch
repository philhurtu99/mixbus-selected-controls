+void
+ProcessorBox::open_inserted_plugins (ProcSelection const& added)
+{
+	if (!UIConfiguration::instance().get_open_gui_after_adding_plugin()
+	    || !ARDOUR_UI_UTILS::engine_is_running()) return;
+#ifdef MIXBUS
+	bool const single_window = UIConfiguration::instance().get_one_plugin_window_only();
+	unsigned opened = 0;
+	for (auto const& processor : added) {
+		auto insert = std::dynamic_pointer_cast<PluginInsert>(processor);
+		if (!insert || insert->is_channelstrip()
+		    || (insert->what_can_be_automated().empty() && !insert->plugin()->has_editor())) continue;
+		auto proxy = processor->window_proxy();
+		if (!proxy) continue;
+		proxy->set_custom_ui_mode(true);
+		proxy->show_the_right_window(true);
+		if (auto window = proxy->get(false)) {
+			int base_x = 0, base_y = 0;
+			if (auto top = dynamic_cast<Gtk::Window*>(get_toplevel())) top->get_position(base_x, base_y);
+			window->move(base_x + 40 + (opened % 8) * 32, base_y + 40 + (opened % 8) * 32);
+			++opened;
+		}
+		if (single_window && opened) break;
+	}
+#else
+	if (added.size() == 1) {
+		auto insert = std::dynamic_pointer_cast<PluginInsert>(added.front());
+		if (insert && !insert->what_can_be_automated().empty()
+		    && !(insert->plugin()->has_inline_display() && UIConfiguration::instance().get_prefer_inline_over_gui())) edit_processor(insert);
+	}
+#endif
+}
