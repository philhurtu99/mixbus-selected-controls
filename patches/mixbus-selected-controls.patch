+#ifdef MIXBUS
+namespace {
+thread_local bool linking_selected_controls = false;
+
+bool link_selected_controls (Session& session, AutomationControl& source, double value, bool apply_source = true)
+{
+	if (linking_selected_controls || session.loading() || session.deletion_in_progress()
+	    || !Config->get_implicit_selection_op_groups() || AudioEngine::instance()->in_process_thread()
+	    || source.automation_state() != Off || session.selection().selected() < 2) {
+		return false;
+	}
+
+	CoreSelection::StripableAutomationControls selected;
+	session.selection().get_stripables(selected);
+	std::vector<std::shared_ptr<Route>> routes;
+	for (auto const& item : selected) {
+		std::shared_ptr<Route> route = std::dynamic_pointer_cast<Route>(item.stripable);
+		if (route && !route->is_master() && !route->is_monitor()) routes.push_back(route);
+	}
+	if (routes.size() < 2) return false;
+
+	std::shared_ptr<AutomationControl> control = std::dynamic_pointer_cast<AutomationControl>(source.shared_from_this());
+	std::shared_ptr<Route> owner;
+	for (auto const& route : routes) {
+		if (route->selected_control_counterpart(*route, control) == control) {
+			owner = route;
+			break;
+		}
+	}
+	if (!owner) return false;
+
+	AutomationControlList targets;
+	for (auto const& route : routes) {
+		if (route == owner) continue;
+		std::shared_ptr<AutomationControl> target = route->selected_control_counterpart(*owner, control);
+		if (target && target != control && target->writable() && target->automation_state() == Off
+		    && target->lower() == source.lower() && target->upper() == source.upper()
+		    && target->toggled() == source.toggled()) {
+			targets.push_back(target);
+		}
+	}
+	if (targets.empty()) return false;
+
+	PBD::Unwinder<bool> guard(linking_selected_controls, true);
+	// ForGroup bypasses other groups and is also carried into queued RT events.
+	if (apply_source) source.set_value(value, PBD::Controllable::ForGroup);
+	for (auto const& target : targets) target->set_value(value, PBD::Controllable::ForGroup);
+	return true;
+
+}
