+namespace {
+#ifdef MIXBUS
+std::shared_ptr<Processor>
+matching_processor (Route const& source_route, Route const& target_route, std::shared_ptr<Processor> source)
+{
+	if (source == source_route.amp()) return target_route.amp();
+	auto insert = std::dynamic_pointer_cast<PluginInsert> (source);
+	if (!insert || !insert->plugin()) return {};
+	auto matches = [&insert] (std::shared_ptr<Processor> p) {
+		auto other = std::dynamic_pointer_cast<PluginInsert> (p);
+		if (!other || !other->plugin() || other->channelstrip() != insert->channelstrip()) return false;
+		if (insert->channelstrip() != Processor::None) return true;
+		return other->type() == insert->type() && other->plugin()->unique_id() == insert->plugin()->unique_id();
+	};
+	uint32_t occurrence = 0;
+	bool found = false;
+	for (uint32_t i = 0; auto p = source_route.nth_plugin(i); ++i) {
+		if (p == source) { found = true; break; }
+		if (matches(p)) ++occurrence;
+	}
+	if (!found) return {};
+	for (uint32_t i = 0; auto p = target_route.nth_plugin(i); ++i) {
+		if (matches(p) && occurrence-- == 0) return p;
+	}
+	return {};
+}
+#endif
+}
+
+std::vector<std::shared_ptr<Route>>
+ProcessorBox::selected_processor_peers () const
+{
+	std::vector<std::shared_ptr<Route>> routes;
+#ifdef MIXBUS
+	if (!_session || !_route || !_route->is_selected() || _route->is_master() || _route->is_monitor()
+	    || !Config->get_implicit_selection_op_groups()
+	    || Keyboard::the_keyboard().key_is_down(GDK_Shift_L)
+	    || Keyboard::the_keyboard().key_is_down(GDK_Shift_R)) return routes;
+	CoreSelection::StripableAutomationControls selected;
+	_session->selection().get_stripables (selected);
+	for (auto const& item : selected) {
+		auto route = std::dynamic_pointer_cast<Route> (item.stripable);
+		if (route && route != _route && !route->is_master() && !route->is_monitor()) routes.push_back(route);
+	}
+#endif
+	return routes;
+}
+
+ProcessorBox::ProcSelection
+ProcessorBox::replicate_plugin_insertion (std::shared_ptr<Processor> processor, std::shared_ptr<Processor> before)
+{
+	ProcSelection added;
+#ifdef MIXBUS
+	auto insert = std::dynamic_pointer_cast<PluginInsert> (processor);
+	if (!insert || insert->is_channelstrip()) return added;
+	auto peers = selected_processor_peers();
+	if (peers.empty()) return added;
+	std::unique_ptr<XMLNode> saved (&insert->get_state());
+	std::string failed;
+	for (auto const& route : peers) {
+		auto copy = std::make_shared<PluginInsert> (*_session, *route);
+		PBD::ID id = copy->id();
+		XMLNode state (*saved);
+		// Let each route configure its own IO; do not copy sidechain port names.
+		state.remove_nodes_and_delete ("Processor");
+		uint32_t count = 0;
+		state.get_property ("count", count);
+		state.remove_property ("count");
+		state.remove_property ("custom");
+		for (auto name : {"ConfiguredInput", "CustomSinks", "ConfiguredOutput", "PresetOutput", "ThruMap"}) state.remove_nodes_and_delete(name);
+		for (uint32_t i = 0; i < count; ++i) {
+			state.remove_nodes_and_delete (string_compose("InputMap-%1", i));
+			state.remove_nodes_and_delete (string_compose("OutputMap-%1", i));
+		}
+		int rv;
+		{
+			PBD::Stateful::ForceIDRegeneration force_ids;
+			rv = copy->set_state (state, Stateful::current_state_version);
+		}
+		copy->update_id (id);
+		if (!rv) {
+			auto anchor = matching_processor (*_route, *route, before);
+			rv = route->add_processor (copy, anchor, nullptr, Config->get_new_plugins_active());
+		}
+		if (rv) failed += (failed.empty() ? "" : ", ") + route->name();
+		else added.push_back(copy);
+	}
+	if (!failed.empty()) {
+		MessageDialog am (string_compose (_("Could not insert the plugin on these selected channels: %1"), failed));
+		am.run();
+	}
+#endif
+	return added;
+}
