+void
+ProcessorBox::set_processor_enabled (std::shared_ptr<Processor> processor, bool state, bool link_selection)
+{
+#ifdef MIXBUS
+	// The fader is the route's Amp, not a PluginInsert. Identify it by owner
+	// so trim and other gain stages are never enabled in its place.
+	if (link_selection && _session && _route && processor == _route->amp()
+	    && _route->is_selected() && !_route->is_master() && !_route->is_monitor()
+	    && Config->get_implicit_selection_op_groups()) {
+		CoreSelection::StripableAutomationControls selected;
+		_session->selection().get_stripables (selected);
+		for (auto const& item : selected) {
+			auto route = std::dynamic_pointer_cast<Route> (item.stripable);
+			if (!route || route == _route || route->is_master() || route->is_monitor()) continue;
+			if (route->amp() && route->amp()->bypassable()) route->amp()->enable (state);
+		}
+	}
+	// LEDs use Processor::enable rather than the knob's AutomationControl path.
+	// Match channelstrip roles or plugin identity/occurrence, never chain slots.
+	std::shared_ptr<PluginInsert> source = std::dynamic_pointer_cast<PluginInsert> (processor);
+	if (link_selection && source && source->bypassable() && _session && _route
+	    && _route->is_selected() && !_route->is_master() && !_route->is_monitor()
+	    && Config->get_implicit_selection_op_groups()) {
+		uint32_t occurrence = 0;
+		auto matches = [&source] (std::shared_ptr<PluginInsert> const& other) {
+			if (!other || other->channelstrip() != source->channelstrip()) return false;
+			if (source->channelstrip() != Processor::None) return true;
+			return source->plugin() && other->plugin()
+			    && source->type() == other->type()
+			    && source->plugin()->unique_id() == other->plugin()->unique_id();
+		};
+		bool found = false;
+		for (uint32_t i = 0; auto p = _route->nth_plugin(i); ++i) {
+			if (p == processor) { found = true; break; }
+			if (matches (std::dynamic_pointer_cast<PluginInsert> (p))) ++occurrence;
+		}
+		if (found) {
+			CoreSelection::StripableAutomationControls selected;
+			_session->selection().get_stripables (selected);
+			for (auto const& item : selected) {
+				auto route = std::dynamic_pointer_cast<Route> (item.stripable);
+				if (!route || route == _route || route->is_master() || route->is_monitor()) continue;
+				uint32_t remaining = occurrence;
+				for (uint32_t i = 0; auto p = route->nth_plugin(i); ++i) {
+					auto target = std::dynamic_pointer_cast<PluginInsert> (p);
+					if (!matches (target)) continue;
+					if (remaining-- != 0) continue;
+					if (target->bypassable()) target->enable (state);
+					break;
+				}
+			}
+		}
+	}
+#endif
+	processor->enable (state);
+}
