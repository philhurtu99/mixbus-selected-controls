+#ifdef MIXBUS
+std::shared_ptr<AutomationControl>
+Route::selected_control_counterpart (Route const& source, std::shared_ptr<AutomationControl> const& control) const
+{
+	if (!control || is_master() || is_monitor() || source.is_master() || source.is_monitor()) {
+		return std::shared_ptr<AutomationControl>();
+	}
+
+	// Channelstrip controls are identified semantically, not by plugin port number.
+	for (auto const& mapping : source._well_known_map) {
+		for (uint32_t band = 0; band < mapping.second.size(); ++band) {
+			if (mapping.second[band].lock() == control) {
+				std::shared_ptr<AutomationControl> candidate = mapped_control(mapping.first, band);
+				// A parameter with a different DSP port/name is not the same knob.
+				if (candidate && candidate->desc().label == control->desc().label) {
+					return candidate;
+				}
+				return std::shared_ptr<AutomationControl>();
+			}
+		}
+	}
+
+	if (source.gain_control() == control) return gain_control();
+	if (source.trim_control() == control) return trim_control();
+	if (source.pan_azimuth_control() == control) return pan_azimuth_control();
+	if (source.pan_width_control() == control) return pan_width_control();
+	if (source.pan_elevation_control() == control) return pan_elevation_control();
+	if (source.pan_frontback_control() == control) return pan_frontback_control();
+	if (source.pan_lfe_control() == control) return pan_lfe_control();
+	if (source.master_send_enable_controllable() == control) return master_send_enable_controllable();
+
+	// Built-in bus slots have a stable destination across channelstrips.
+	if (source._mixbus_send && _mixbus_send) {
+		uint32_t n = std::min(source._mixbus_send->n_busses(), _mixbus_send->n_busses());
+		for (uint32_t bus = 0; bus < n; ++bus) {
+			if (source.send_level_controllable(bus) == control) return send_level_controllable(bus);
+			if (source.send_enable_controllable(bus) == control) return send_enable_controllable(bus);
+			if (source.send_point_controllable(bus) == control) return send_point_controllable(bus);
+			if (source.send_pan_azimuth_controllable(bus) == control) return send_pan_azimuth_controllable(bus);
+			if (source.send_pan_azimuth_enable_controllable(bus) == control) return send_pan_azimuth_enable_controllable(bus);
+		}
+	}
+
+	// Auxiliary send order can differ: identify the receiving bus instead.
+	for (uint32_t i = 0; ; ++i) {
+		std::shared_ptr<Send> send = std::dynamic_pointer_cast<Send>(source.nth_send(i));
+		if (!send) break;
+		if (send->gain_control() != control) continue;
+		std::shared_ptr<InternalSend> internal = std::dynamic_pointer_cast<InternalSend>(send);
+		if (!internal) return std::shared_ptr<AutomationControl>();
+		for (uint32_t j = 0; ; ++j) {
+			std::shared_ptr<InternalSend> other = std::dynamic_pointer_cast<InternalSend>(nth_send(j));
+			if (!nth_send(j)) break;
+			if (other && other->target_id() == internal->target_id()) return other->gain_control();
+		}
+		return std::shared_ptr<AutomationControl>();
+	}
+
+	Evoral::Parameter const& param = control->parameter();
+	if (param.type() != PluginAutomation) {
+		std::shared_ptr<AutomationControl> owned = const_cast<Route&>(source).automation_control(param, false);
+		if (owned == control) return const_cast<Route*>(this)->automation_control(param, false);
+		return std::shared_ptr<AutomationControl>();
+	}
+
+	// User plugins: same format, unique ID and occurrence, never an unrelated slot.
+	std::map<std::pair<PluginType, std::string>, uint32_t> occurrences;
+	for (uint32_t i = 0; ; ++i) {
+		std::shared_ptr<PluginInsert> insert = std::dynamic_pointer_cast<PluginInsert>(source.nth_plugin(i));
+		if (!insert) break;
+		std::shared_ptr<Plugin> plug = insert->plugin(0);
+		if (!plug || !plug->get_info()) continue;
+		auto identity = std::make_pair(plug->get_info()->type, plug->unique_id());
+		uint32_t occurrence = occurrences[identity]++;
+		if (insert->automation_control(param, false) != control) continue;
+		for (uint32_t j = 0; ; ++j) {
+			std::shared_ptr<PluginInsert> other = std::dynamic_pointer_cast<PluginInsert>(nth_plugin(j));
+			if (!other) break;
+			std::shared_ptr<Plugin> op = other->plugin(0);
+			if (!op || !op->get_info() || op->get_info()->type != identity.first || op->unique_id() != identity.second) continue;
+			if (occurrence-- == 0) return other->automation_control(param, false);
+		}
+		return std::shared_ptr<AutomationControl>();
+	}
+	return std::shared_ptr<AutomationControl>();
+}
+#endif
+
 std::shared_ptr<Processor>
 Route::nth_plugin (uint32_t n) const
 {
